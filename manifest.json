{
    "manifest_version": 3,
    "name": "eu te amo microsoft",
    "version": "1.0",
    "description": "mapeia todos os clicáveis da página e mapeia teclas, ou combinações de teclas, para acioná-los",
    "permssions": [
        "activeTab"
    ],
    "content_scripts":[
        {
            "matches": ["<all_urls>"],
            "css": ["cards.css"],
            "js": ["content_script.js"]
        }
    ],
    "commands": {
        "_execute_shortpaths":{
            "suggested_key":{
                "default": "Ctrl+A"
            }
        }
    }
}